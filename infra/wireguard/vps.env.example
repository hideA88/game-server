# Copy this file to vps.env and keep the copied file out of Git.
WG_INTERFACE=wg0
WG_PORT=51820
WG_VPS_ADDRESS=10.77.0.1/30
WG_HOME_ADDRESS=10.77.0.2/32

# Usually detected from the VPS default route. Set it only when detection is wrong.
VPS_PUBLIC_INTERFACE=

ENABLED_GAMES=palworld

# Add this after running install-home.sh on the game server.
HOME_PUBLIC_KEY=

# Set true only if UFW is already your host firewall.
MANAGE_UFW=false
