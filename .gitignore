# Environment variables
.env
.env.*
!.env.template
!*.env.example

# WireGuard local configuration and generated secrets
infra/wireguard/*.env
!infra/wireguard/*.env.example
infra/wireguard/generated/
*.key
*.psk

# Game data directories
games/*/data/
games/*/config/*.json
games/*/config/*.properties

# ARK specific exclusions
games/ark/ASA_Island/
games/ark/Dedicated Server/
games/ark/scorchedEarth/
games/ark/Game.ini
games/ark/GameUserSettings.ini
games/ark/config/Game.ini
games/ark/config/GameUserSettings.ini

# Palworld server binaries, saves, and backups
games/palworld/

# Log files
shared/logs/*
games/*/logs/

# Docker volumes
volumes/

# MCXboxBroadcast device-login tokens and session cache
config/mcxboxbroadcast/

# IDE specific files
.idea/
.vscode/
*.swp
*.swo

# OS specific files
.DS_Store
Thumbs.db

# Downloaded third-party add-ons (All Rights Reserved; do not redistribute)
games/minecraft/addons/

# Local world backups
games/*/backups/
